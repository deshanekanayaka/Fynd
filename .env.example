# Copy this file to .env and fill in the values. The .env file is never committed.

# Semantic Scholar Academic Graph API key.
# Without a key the search endpoint is throttled and shared with everyone.
SEMANTIC_SCHOLAR_API_KEY=

# Anthropic API key. Haiku 4.5 proposes the Topics and extracts the Claims, and
# Opus 5 drafts the Proposal.
ANTHROPIC_API_KEY=

# Where every external fetch is cached on disk.
FYND_CACHE_DIR=.cache

# The operator address. Every outbound request names a human, so a
# repository administrator can reach you. See docs/adr/0007.
FYND_CONTACT_EMAIL=

# Voyage API key. The ranking embeds every abstract in the pool with
# voyage-4-lite and reorders the top of it with rerank-3-lite. The account is
# prepaid with automatic recharge off, so a loop costs a failed request and
# never a bill. See docs/adr/0013.
VOYAGE_API_KEY=
